{
  "SyncFolder": {
    "SourcePath": "d:\\Temp\\TestSync1",
    "DestinationPath": "d:\\Temp\\TestSync2",
    "IntervalMinutes": 1440,  // once a day
    "Schedule": {
      "Enabled": true,
      "Days": [ "Friday" ],
      "Hour": 13,
      "Minute": 29,
      "TimeZoneId": null
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft.Hosting.Lifetime": "Information",
      "SyncFolderService.SyncLogic": "Error",
      "SyncFolderService": "Information"
    },
    "Serilog": {
      "MinimumLevel": {
        "Default": "Information"
      },
      "FileName": "log-.txt"
    }
  }
}
